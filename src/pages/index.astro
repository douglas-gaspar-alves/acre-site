---
import Layout from "@/layouts/CampaignLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import HeroBlackFriday from "@/components/content/HeroBlackFriday.astro";
import SignupBlackFriday from "@/components/content/SignupBlackFriday.astro";
---

<Layout
  title="Black Friday"
  description="Contrate um gerente e leve uma agência completa. Cadastre-se para conhecer a oferta A.C.R.E. e dois bônus exclusivos da Black Friday. Revelação na quinta-feira."
  noindex
>
  <!-- Black Friday -->
  <Section
    paddingTop="small"
    paddingBottom="small"
    class="flex-grow background-transparent"
    aria-labelledby="oferta-title"
  >
    <ContentWrapper centered>
      <HeroBlackFriday />
    </ContentWrapper>
  </Section>
  <SignupBlackFriday />
</Layout>
<SignupBlackFriday />

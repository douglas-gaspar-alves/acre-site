---
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import SignupBlackFriday from '@/components/content/SignupBlackFriday.astro';

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Utility classes. */
  class?: string;
}
const { render = true, class: className } = Astro.props;
const stages = [
  { name: "Atrair", color: "#FFBC00", letter: "A" },
  { name: "Converter", color: "#00F000", letter: "C" },
  { name: "Relacionar", color: "#0064CE", letter: "R" },
  { name: "Estudar", color: "#FF0000", letter: "E" },
];
---

{render && (
  <div class:list={["hero-black-friday_wrap", className]}>
    <div class="hero-black-friday_eyebrow">
      <span class="hero-black-friday_badge">BLACK FRIDAY</span>
      <span class="hero-black-friday_access">EXCLUSIVA PARA CADASTRADOS</span>
    </div>
    <h1 id="oferta-title" class="hero-black-friday_title text-style-h1">
      Contrate um gerente de marketing.
      <br />Leve a estrutura de{" "}
      <span class="hero-black-friday_highlight">
        uma agência.
      </span>
    </h1>
    <p class="hero-black-friday_context">
      Seu marketing com método e inteligência artificial.
      <br />
      Uma proposta para quem quer organizar a operação da sua agência.
    </p>
    <div class="hero-black-friday_bonus">
      <svg
        class="hero-black-friday_gift"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M4 11h16v10H4zM3 7h18v4H3zM12 7v14M12 7H8.5A2.5 2.5 0 1 1 11 4.5L12 7Zm0 0h3.5A2.5 2.5 0 1 0 13 4.5L12 7Z" />
      </svg>
      <p>
        E mais <strong>2 bônus exclusivos</strong>
        <br class="hero-black-friday_mobile-break" /> que só vão valer na Black
        Friday.
      </p>
    </div>
    <p class="hero-black-friday_reveal">
      A oferta será revelada <strong>na quinta-feira.</strong>
      <br />
      Apenas para quem estiver na lista.
    </p>
    <ButtonWrapper>
      <button
        type="button"
        class="button_wrap hero-black-friday_cta"
        data-modal-open="black-friday-cadastro"
        aria-haspopup="dialog"
        aria-controls="black-friday-cadastro"
      >
        Quero receber a oferta{" "}
        <span class="hero-black-friday_arrow" aria-hidden="true">
          ↗
        </span>
      </button>
    </ButtonWrapper>
    <p class="hero-black-friday_note">
      <svg
        width="12"
        height="12"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        aria-hidden="true"
      >
        <rect x="3" y="7" width="10" height="7" rx="1.5" />
        <path d="M5 7V4a3 3 0 0 1 6 0v3" />
      </svg>
      Cadastro sem compromisso. Não é uma contratação.
    </p>
    <div class="hero-black-friday_method">
      <p class="hero-black-friday_method-label">
        UM MÉTODO. QUATRO ETAPAS CONECTADAS.
      </p>
      <ol
        class="hero-black-friday_stages"
        aria-label="Etapas do Método A.C.R.E."
      >
        {stages.map((stage) => (
          <li class="hero-black-friday_stage">
            <span
              class="hero-black-friday_letter"
              style={`--stage-color: ${stage.color}`}
              aria-hidden="true"
            >
              {stage.letter}
            </span>
            {stage.name}
          </li>
        ))}
      </ol>
    </div>
  </div>
)}

<style is:global>
  @layer components {
    .hero-black-friday_wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      text-align: center;
      .hero-black-friday_eyebrow {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 2.75rem;
        font-size: 0.75rem;
        letter-spacing: 0.13em;
      }
      .hero-black-friday_badge {
        padding: 0.6rem 0.85rem;
        background: var(--brand-500);
        color: var(--dark-900);
        border-radius: 0.25rem;
        font-weight: 700;
      }
      .hero-black-friday_access {
        color: #b1b6ad;
      }
      .hero-black-friday_title {
        max-width: 34ch;
        font-size: clamp(2.75rem, 5.4vw, 5.25rem);
        line-height: 1.09;
        letter-spacing: -0.055em;
        margin: 0;
      }
      .hero-black-friday_highlight {
        color: var(--brand-500);
      }
      .hero-black-friday_context {
        color: #a6ada1;
        font-size: 1.125rem;
        line-height: 1.8;
        max-width: 66ch;
        margin-top: 2.25rem;
      }
      .hero-black-friday_bonus {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.85rem;
        margin-top: 2.25rem;
        padding: 1.25rem 1.75rem;
        border: var(--border-width) solid #ffffff15;
        border-radius: 0.6rem;
        background: #ffffff03;
        font-size: 1rem;
        line-height: 1.6;
      }
      .hero-black-friday_bonus strong {
        font-weight: 600;
        color: var(--brand-500);
      }
      .hero-black-friday_gift {
        width: 1.5rem;
        height: 1.5rem;
        color: var(--brand-500);
        flex-shrink: 0;
      }
      .hero-black-friday_reveal {
        margin-top: 2.25rem;
        font-size: 1rem;
        color: #a6ada1;
        line-height: 1.8;
      }
      .hero-black-friday_reveal strong {
        color: var(--text);
        font-weight: 500;
      }
      .hero-black-friday_cta {
        min-height: 4rem;
        padding: 1.1em 2.25em;
        font-size: 1.125rem;
        font-weight: 600;
      }
      .hero-black-friday_arrow {
        display: inline-block;
        margin-left: 1.25em;
        font-size: 1.2em;
      }
      .hero-black-friday_note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 1rem;
        font-size: 0.8125rem;
        line-height: 1.6;
        color: #a6ada1;
      }
      .hero-black-friday_method {
        margin-top: 4rem;
      }
      .hero-black-friday_method-label {
        font-size: 0.75rem;
        letter-spacing: 0.18em;
        color: #a6ada1;
        margin-bottom: 1.25rem;
      }
      .hero-black-friday_stages {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 1.75rem;
      }
      .hero-black-friday_stage {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9375rem;
        color: #c5c9c2;
      }
      .hero-black-friday_letter {
        display: grid;
        place-items: center;
        width: 1.9rem;
        height: 1.9rem;
        font-size: 0.8125rem;
        border: var(--border-width) solid
          color-mix(in srgb, var(--stage-color) 40%, transparent);
        border-radius: 50%;
        color: var(--stage-color);
        background: color-mix(in srgb, var(--stage-color) 7%, transparent);
      }
      .hero-black-friday_mobile-break {
        display: none;
      }
      @media (width < 30rem) {
        .hero-black-friday_eyebrow {
          gap: 0.75rem;
          margin-bottom: 1.75rem;
          font-size: 0.6875rem;
        }
        .hero-black-friday_title {
          font-size: clamp(2.25rem, 9.8vw, 2.9rem);
        }
        .hero-black-friday_context {
          font-size: 1rem;
        }
        .hero-black-friday_bonus {
          padding: 0.9rem 1rem;
          font-size: 0.9375rem;
        }
        .hero-black-friday_mobile-break {
          display: initial;
        }
        .hero-black-friday_stages {
          display: grid;
          grid-template-columns: repeat(2, 1fr);
          gap: 1rem 1.75rem;
        }
        .hero-black-friday_note {
          font-size: 0.75rem;
        }
        .hero-black-friday_method {
          margin-top: 2.5rem;
        }
      }
    }
  }
</style>

<SignupBlackFriday />
